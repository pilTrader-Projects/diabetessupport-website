{
  "name": "diabetessupport-website",
  "version": "1.0.0",
  "description": "Custom Next.js & MongoDB Platform for Diabetes Care & PWA App Ecosystem",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "test": "jest --passWithNoTests",
    "sanity": "ts-node tests/sanity_check.ts",
    "lint": "eslint .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "migrate:wp": "ts-node scripts/migrate-wordpress.ts"
  },
  "keywords": [
    "nextjs",
    "diabetes-care",
    "mongodb",
    "pwa-promotion",
    "adsense"
  ],
  "author": "pilTrader",
  "license": "MIT",
  "dependencies": {
    "@tiptap/extension-image": "^3.31.2",
    "@tiptap/extension-link": "^3.31.2",
    "@tiptap/extension-placeholder": "^3.31.2",
    "@tiptap/pm": "^3.31.2",
    "@tiptap/react": "^3.31.2",
    "@tiptap/starter-kit": "^3.31.2",
    "mongoose": "^9.9.4",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.0.0",
    "jest": "^30.5.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
