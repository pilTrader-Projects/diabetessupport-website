# ==========================================
# Database Configuration
# ==========================================
# MongoDB Connection URI (MongoDB Atlas or Local instance)
MONGODB_URI=mongodb://localhost:27017/diabetessupport

# ==========================================
# API Authentication & Automation
# ==========================================
# Secret API Key for external AI content generator scripts (POST /api/v1/posts)
API_SECRET_KEY=sk_dev_diabetessupport_secret_key_change_in_production

# Base URL of the website platform
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy WordPress REST API Endpoint (for migration import script)
WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/diabetescareph.wordpress.com

# ==========================================
# Google AdSense Monetization
# ==========================================
# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000

# Enable/Disable Ads (true/false)
NEXT_PUBLIC_ENABLE_ADS=true

# ==========================================
# Brevo (Sendinblue) Email Marketing & Sequences
# ==========================================
# Brevo REST API v3 Key (from Account -> SMTP & API -> API Keys)
BREVO_API_KEY=
 
